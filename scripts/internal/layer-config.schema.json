{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Layer Configuration",
  "description": "Schema for validating layer configuration YAML files with index, type, z-position, and height",
  "type": "object",
  "properties": {
    "pdk_config": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "def_color": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^(?!pdk_config$)[A-Za-z0-9_]+$": {
      "type": "object",
      "required": ["index", "type", "z", "height"],
      "properties": {
        "index": {
          "type": "integer",
          "description": "Layer index number",
          "minimum": 0
        },
        "type": {
          "type": "integer",
          "description": "Layer type/datatype",
          "minimum": 0
        },
        "z": {
          "type": "number",
          "description": "Z-position of the layer (vertical position in 3D space)"
        },
        "height": {
          "type": "number",
          "description": "Height/thickness of the layer",
          "minimum": 0
        },
        "purpose": {
          "type": "string",
          "enum": ["filler", "mask"],
          "description": "Purpose of this layer"
        },
        "cut_by": {
          "type": "array",
          "description": "Layers subtracted from this layer before it is extruded",
          "items": {
            "type": "string"
          }
        },
        "wrap_around": {
          "type": "object",
          "description": "Wrap around one fin below the cap, or subtract nanosheet volumes from the full envelope",
          "oneOf": [
            {"required": ["layer"], "not": {"required": ["layers"]}},
            {"required": ["layers"], "not": {"anyOf": [
              {"required": ["layer"]}, {"required": ["z_extend"]}
            ]}}
          ],
          "properties": {
            "layers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string"},
              "description": "Nanosheet layers removed from this layer's z/height envelope"
            },
            "layer": {
              "type": "string",
              "description": "Reference layer this layer wraps around"
            },
            "z_extend": {
              "type": "number",
              "description": "Distance the walls reach below the reference layer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
